<Window x:Class="EnvEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EnvEditor"
        Title="EnvEditor — 环境变量同步" Height="720" Width="1040">
    <!-- IsBusy 时整窗等待光标，给用户明确反馈 -->
    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Cursor" Value="Wait"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Window.Resources>
        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#D0E8FF"/>
                                <Setter Property="BorderBrush" Value="#2D7DD2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部导航 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <RadioButton x:Name="TabSync" GroupName="Nav" Content="同步" IsChecked="True"
                         Checked="OnNavSync" Style="{StaticResource NavTab}"/>
            <RadioButton x:Name="TabSettings" GroupName="Nav" Content="设置"
                         Checked="OnNavSettings" Style="{StaticResource NavTab}"/>
        </StackPanel>

        <!-- 页面容器 -->
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>

        <!-- 共享状态栏 -->
        <StatusBar Grid.Row="2">
            <TextBlock Text="{Binding StatusMessage}"/>
            <Separator/>
            <TextBlock Text="仅用户变量(HKCU) · 仅HTTPS+PAT · 变量改动对新建进程生效 · 密钥遗忘=数据永久不可解密"
                       Foreground="Gray" FontSize="11"/>
        </StatusBar>
    </Grid>
</Window>
