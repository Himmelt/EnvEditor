<Page x:Class="EnvEditor.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:EnvEditor"
      Title="设置">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="仓库与同步设置" Padding="10">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第 0 行：同步ID / 分支 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="同步ID" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SyncId, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="分支" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Branch, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>

                <!-- 第 1 行：仓库URL / 用户名 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="仓库URL" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RepoUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="用户名" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>

                <!-- 第 2 行：邮箱 / PAT -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="邮箱" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="PAT" VerticalAlignment="Center"/>
                <PasswordBox Grid.Row="2" Grid.Column="4"
                             local:PasswordBoxAssistant.Password="{Binding PatInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3" ToolTip="Git 仓库的 Personal Access Token"/>

                <!-- 第 3 行：凭据目标(可选) + 使用系统凭据管理器 -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="凭据目标(可选)" VerticalAlignment="Center"
                           ToolTip="留空则用 git:https://{host}；可覆盖为自定义目标名"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CredentialTarget, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"
                         ToolTip="留空则用 git:https://{host}；可覆盖为自定义目标名"/>
                <CheckBox Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2"
                          Content="使用系统凭据管理器" IsChecked="{Binding UseSystemCredential}"
                          VerticalAlignment="Center" Margin="0,3"
                          ToolTip="勾选后按仓库 URL 从 Windows 凭据管理器取 PAT，无需在此填 PAT"/>

                <!-- 第 4 行：按钮 -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="保存配置" Command="{Binding SaveConfigCommand}" Width="100" Margin="0,0,8,0"/>
                    <Button Content="测试连接" Command="{Binding TestConnectionAsyncCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                            Width="100" Margin="0,0,8,0"
                            ToolTip="校验仓库地址/PAT 是否可用（执行一次 fetch）"/>
                    <Button Content="取消" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"
                            Width="80" Foreground="DarkRed"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Page>
