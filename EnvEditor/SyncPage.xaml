<Page x:Class="EnvEditor.SyncPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:EnvEditor"
      xmlns:models="clr-namespace:EnvEditor.Models"
      Title="同步">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 操作区 -->
        <GroupBox Grid.Row="0" Header="同步操作" Padding="8">
            <WrapPanel Orientation="Horizontal">
                <PasswordBox local:PasswordBoxAssistant.Password="{Binding PasswordInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="180" ToolTip="远端数据的解密密钥"/>
                <CheckBox Content="记住密钥" IsChecked="{Binding RememberEnvPassword}" VerticalAlignment="Center" Margin="6,0"/>
                <Button Content="拉取" Command="{Binding PullAsyncCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" Width="70" Margin="6,0"/>
                <Button Content="应用到本机" Command="{Binding ApplyAsyncCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" Width="90" Margin="6,0"/>
                <Button Content="上传" Command="{Binding PushAsyncCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" Width="70" Margin="6,0"/>
                <Button Content="备份本机" Command="{Binding BackupCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" Width="80" Margin="6,0"/>
                <Button Content="回滚" Command="{Binding RollbackCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" Width="70" Margin="6,0"/>
                <Button Content="刷新" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" Width="70" Margin="6,0"/>
                <Button Content="取消" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" Width="70" Margin="6,0"
                        Foreground="DarkRed" ToolTip="中断正在进行的拉取/应用/上传/测试连接"/>
            </WrapPanel>
        </GroupBox>

        <!-- 搜索 + 本机变量管理 -->
        <GroupBox Grid.Row="1" Header="本机变量管理（直接改注册表，与云端解耦）" Padding="8" Margin="0,4,0,0">
            <StackPanel Orientation="Vertical">
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="搜索" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="4,0"
                             ToolTip="按名称/本地值/远端值过滤"/>
                </WrapPanel>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="名称" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding NewVarName, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="4,0"/>
                    <TextBlock Text="值" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding NewVarValue, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="4,0"/>
                    <TextBlock Text="类型" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding NewVarKind}" Width="120" Margin="4,0"/>
                    <Button Content="添加/保存" Command="{Binding AddLocalCommand}" Width="80" Margin="6,0"/>
                    <Button Content="编辑选中" Command="{Binding EditSelectedCommand}" Width="80" Margin="6,0"/>
                    <Button Content="删除选中" Command="{Binding DeleteLocalCommand}" Width="80" Margin="6,0"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <!-- 变量列表 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredRows}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                  IsReadOnly="False" Margin="0,4" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F7F9FC">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- 高危变量整行淡红底，提醒谨慎操作 -->
                        <DataTrigger Binding="{Binding IsHighRisk}" Value="True">
                            <Setter Property="Background" Value="#FFE5E5"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:SyncState.Unsupported}">
                            <Setter Property="Background" Value="#FFF3E0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="同步" Binding="{Binding IsWhitelisted, Mode=TwoWay}" Width="48"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="160" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Name}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="本地值" Binding="{Binding LocalValue}" Width="260" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding LocalValue}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="远端值" Binding="{Binding RemoteValue}" Width="260" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding RemoteValue}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="状态" Width="90" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <Binding Path="State"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{Binding State, Converter={StaticResource StateBrush}}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="说明" Binding="{Binding Warning}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Warning}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 操作日志 -->
        <Expander Grid.Row="3" Header="操作日志" IsExpanded="False" Margin="0,4,0,0">
            <ListBox ItemsSource="{Binding LogHistory}" Height="120"
                     FontFamily="Consolas" FontSize="11"/>
        </Expander>
    </Grid>
</Page>
